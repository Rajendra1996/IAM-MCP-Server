# Examples only. Set these in each PowerShell process; .env is not loaded automatically.
DATABASE_URL=postgresql://iam_user:iam_password@127.0.0.1:5432/iam
IAM_API_URL=http://127.0.0.1:9000
HR_API_URL=http://127.0.0.1:9100
ITSM_API_URL=http://127.0.0.1:9201
REDIS_URL=redis://127.0.0.1:6380/0
IAM_MCP_HOST=127.0.0.1
IAM_MCP_PORT=8001
IAM_MCP_URL=http://127.0.0.1:8001/mcp
HR_MCP_URL=http://127.0.0.1:8002/mcp
ITSM_MCP_URL=http://127.0.0.1:8003/mcp
GATEWAY_URL=http://127.0.0.1:8080
IAM_REPLICA_A_URL=http://127.0.0.1:8011
IAM_REPLICA_B_URL=http://127.0.0.1:8012
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60
IAM_JWT_SECRET=dev-example-replace-with-your-own-secret-at-least-32-bytes
# Set IAM_ACCESS_TOKEN to a generated employee or approver JWT.
